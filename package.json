{
  "name": "statline-mobile",
  "private": true,
  "version": "1.2.0",
  "description": "STATLINE Sports Analytics for phones and tablets — installable, offline-capable web app",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/copy-ocr-assets.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "data": "tsx scripts/build-data.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.10.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0"
  }
}
